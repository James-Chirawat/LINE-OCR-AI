{
  "name": "line-ai-expense-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run models && next build && node scripts/check-trace.js",
    "start": "next start",
    "models": "node scripts/download-models.js",
    "test": "node --test tests/*.test.js",
    "test:ocr": "node --test tests/ocr.integration.js",
    "test:all": "npm test && npm run test:ocr",
    "fixtures": "node scripts/create-fixtures.js",
    "gemini:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-gemini.js"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@napi-rs/canvas": "^1.1.1",
    "next": "16.4.6",
    "onnxruntime-node": "1.31.1",
    "pdf-to-img": "7.0.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  }
}
